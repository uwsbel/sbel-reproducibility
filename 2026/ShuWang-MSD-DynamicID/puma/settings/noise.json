{
 "groups": [
  {
   "name": "joint_angle",
   "array": "q",
   "noise_sd": 0.0001,
   "unit": "rad",
   "components": 3
  },
  {
   "name": "joint_rate",
   "array": "qd",
   "noise_sd": 0.001,
   "unit": "rad/s",
   "components": 3
  },
  {
   "name": "specific_force",
   "array": "imu_acc",
   "noise_sd": 0.05,
   "unit": "m/s^2",
   "components": 9
  },
  {
   "name": "angular_rate",
   "array": "imu_gyr",
   "noise_sd": 0.005,
   "unit": "rad/s",
   "components": 9
  },
  {
   "name": "torque",
   "array": "tau",
   "noise_sd": 0.05,
   "unit": "N m",
   "components": 3
  }
 ],
 "distribution": "white Gaussian noise, added to every recorded sample",
 "sample_rate_hz": 100,
 "scoring_start_s": 0.2,
 "loss": "soft-L1, rho(e) = 2 s^2 (sqrt(1 + (e / s)^2) - 1), e in noise standard deviations",
 "loss_scale_s": 3.0,
 "band_of_r": "r lies outside the band if abs(r - 1) > 3 / sqrt(2 n), n = scored samples x components"
}
